<!DOCTYPE html>
<html lang="en">

    <head>
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>BBChess - Players</title>
        <link rel="stylesheet" type="text/css" href="/css/style.css?v=2" />
    </head>

    <body class="players">

        <div class="players-nav">
            <a href="/"><img src="/images/icons/homeIcon.png" alt="Back to home button" class="home-icon"></a>
            <h1 class="heading">Players</h1>
        </div>
        <br>
        <div class="players-container">
            <% playerData.forEach(player => { %>
                <a href="/players/<%= player.fName%>" style="font-weight:inherit; color:inherit;text-decoration:none;">
                    <div class = "player">
                        <img src="/images/profiles/<%= player.photoPath %>" alt="Player 1 profile photo">
                        <div>
                            <h3><%=player.fName %><span class="nickname"><%= (player.nickName) ? (' "' + player.nickName + '"') : ""%></span> <%=player.sName%></h3>
                            <p>BBC Elo: <%=parseInt(player.bbcElo)%></p>
                            <p><span class="wins"><%=player.wins%></span>/<span class="losses"><%=player.losses%></span>/<%=player.draws%></p>
                        </div>
                    </div>
                </a>
            <% }); %>
        </div>

    </body>


</html>