<!DOCTYPE html>
<html lang="en">

    <head>
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>BBChess - <%=player.fName%></title>
        <link rel="stylesheet" type="text/css" href="/css/style.css?v=4.0.1" />
    </head>

    <body class="player-body">
        <div class="profile-head">
            <div class="player-nav">
                <a href="/"><img src="/images/icons/homeIcon.png" alt="Back to home icon"></a>
                <a href="/players"><img src="/images/icons/playersIcon.png" alt="Back to tournaments icon"></a>
            </div>
            <div class="profile-head-left">
                <h1 class="heading"><%=player.fName %><span class="nickname"><%= (player.nickName) ? (' "' + player.nickName + '"') : ""%></span> <%=player.sName%></h1>
                <p style="font-weight: 600;"><span class="wins"><%=player.wins%></span>/<span class="losses"><%=player.losses%></span>/<%=player.draws%></p>
                <p>Age: <%=player.age%></p>
                <p>DoB: <%=player.dobStr%></p>
            </div>
            <div class="profile-image">
                <img src="/images/profiles/<%= player.photoPath %>" alt="Player profile photo">
            </div>
            <div class="elo-list">
                <% if(player.lichessUN !== null) {%>
                    <h4>Lichess</h4>
                    <a target="_blank" href=<%=player.links.lichess%>><%=player.lichessUN%></a>
                    <p>Elo: <%=player.rating.lichessElo%></p>
                <%}%>
                <% if(player.chessComUN !== null) {%>
                    <h4>Chess.com</h4>
                    <a target="_blank" href=<%=player.links.chessCom%>><%=player.chessComUN%></a>
                    <p>Current Elo: <%=player.rating.chessComLastElo%></p>
                    <p>Peak Elo: <%=player.rating.chessComBestElo%></p>
                <%}%>
                <h4>BBC Elo</h4>
                <p><%=parseInt(player.bbcElo)%></p>
            </div>
            <div class="achievements">
                <h3>Achievements:</h3>
                <% player.achievements.forEach(achievement => { %>
                    <p>🏆 <%=achievement.achievement%></p>
                <% }); %>
            </div>
        </div>
        <div class="players-tournaments">
            <h2 class="section-title"><a style="font-weight:inherit; color:inherit;text-decoration:none;" href="/tournaments">Tournaments:</a></h2>
            <% player.tournaments.forEach(tournament => { %>
                <div class="tournament-card">
                    <a href="/tournaments/<%=tournament.slug%>" class="tournament-title"><%=tournament.name%></a>
                    <p class="position position-<%=tournament.finalPosition%>">Placing: <%=tournament.finalPosition%></p>
                </div>
            <% }); %>
        </div>
        <div class="tournament-games">
            <h2 class="section-title">Games:</h2>
            <% player.games.forEach(game => { %>
                <div class="game-container">
                    <div class="game-card">
                        <p class="result result-<%=game.resultStr%>"><%=game.resultStr%></p>
                        <p class="game-card-white-player"><span class="white-highlight">White</span> - <a style="font-weight:inherit; color:inherit;text-decoration:none;" href="/players/<%=game.whiteName%>"><span class="bold-<%=(game.whiteName == player.fName)%>"><%=game.whiteName%></span></a></p>
                        <p class="game-card-white-player-mobile"><span class="white-highlight">White</span> <a style="font-weight:inherit; color:inherit;text-decoration:none;" href="/players/<%=game.whiteName%>"><span class="bold-<%=(game.whiteName == player.fName)%>"><%=game.whiteName%></span></a></p>
                        <p class="game-card-result"><%=game.result%></p>
                        <p class="game-card-black-player"><a style="font-weight:inherit; color:inherit;text-decoration:none;" href="/players/<%=game.blackName%>"><span class="bold-<%=(game.blackName == player.fName)%>"><%=game.blackName%></span></a> - <span class="black-highlight">Black</span></p>
                        <p class="game-card-black-player-mobile"><span class="black-highlight">Black</span> <a style="font-weight:inherit; color:inherit;text-decoration:none;" href="/players/<%=game.blackName%>"><span class="bold-<%=(game.blackName == player.fName)%>"><%=game.blackName%></span></a></p>
                        <div class="game-card-extras">
                            <p class="game-card-type"><%= (game.locationID == 1) ? "Online" : "OTB" %></p>
                            <p class="game-card-date"><%=game.dateStr%></p>
                            <button class="iframe-button-<%=(game.link !== null)%> iframe-button"><%= (game.link) ? "🔽" : ""%></button>
                            <a class="view-game-<%= (game.link !== null)%>" target="_blank" href="https://lichess.org/<%=game.link%>"><img class="game-card-view-game" src="/images/icons/chessLinkIcon.png" alt="View Game"></a>
                            <button class="notes-<%=(game.notes !== null)%> notes-button"><%= (game.notes) ? "📝" : ""%></button>
                        </div>
                    </div>
                    <div class="iframe-section iframe-active-false">
                        <iframe class="lichess-embed" data-src = "https://lichess.org/embed/game/<%=game.link%>?theme=auto&bg=auto" src=""></iframe>
                    </div>
                    <div class="notes-section note-active-false">
                        <p><%= game.notes %></p>
                    </div>
                </div>
            <% }); %>
        </div>
    <script src="/js/main.js?v=3"></script>
    </body>


</html>