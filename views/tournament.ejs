<!DOCTYPE html>
<html lang="en">

    <head>
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>BBChess - <%=tournament.name%></title>
        <link rel="stylesheet" type="text/css" href="/css/style.css?v=4" />
    </head>

    <body class="tournament">
        <div class="tournament-head">
            <div class="tournament-nav">
                <a href="/"><img src="/images/icons/homeIcon.png" alt="Back to home icon"></a>
                <a href="/tournaments"><img src="/images/icons/tournamentIcon.png" alt="Back to tournaments icon"></a>
            </div>
            <div class="tournament-image">
                <img src="/images/tournaments/<%=tournament.photoPath%>" alt="Cover photo for the tournament">
            </div>
            <div class="tournament-descriptions">
                <h1 class="heading tournament-heading"><%=tournament.name %></h1>
                <p><%= tournament.description %></p>
                <p><%= tournament.startDateStr %> - <%= tournament.endDateStr %></p>
                <p>⌛ <%= tournament.timeControl %> (<%= tournament.baseTime %> + <%= tournament.bonusTime %>)</p>
            </div>
        </div>
        <div>
            <h2 class="section-title">Rankings:</h2>
            <% tournament.players.forEach(player => { %>
                <div class="ranking-card ranking-<%=player.finalPosition%> shine-<%= player.finalPosition<=3 %>">
                    <p class="ranking-card-position"><%= player.finalPosition %></p>
                    <a href="/players/<%= player.fName %>" style="font-weight:inherit; color:inherit;text-decoration:none;" class="ranking-card-player"><%= player.fName %> <%= player.sName %><%= (player.finalPosition==1) ? " 👑" : "" %></a>
                    <div class="ranking-card-point-section">
                        <p class="ranking-card-points"><%= player.score %> point<span class="points-<%=player.score%>">s</span></p>
                        <p>(<span class="wins"><%= player.wins %></span>/<span class="losses"><%= player.losses %></span>/<%= player.draws %>)</p>
                    </div>
                </div>
            <% }); %>
        </div>
        <div class="tournament-games">
            <h2 class="section-title">Games:</h2>
            <% tournament.games.forEach(game => { %>
                <div class="game-container">
                    <div class="tournament-game-card">
                        <div class="game-card-white-player-div">
                            <p class="game-card-white-player"><span class="white-highlight">White</span> - <a style="font-weight:inherit; color:inherit;text-decoration:none;" href="/players/<%=game.whiteName%>" class="game-win-<%=(game.result==="1-0")%>"><%=game.whiteName%></a></p>
                            <p class="tournament-game-card-white-player-mobile"><span class="white-highlight">White</span> <a style="font-weight:inherit; color:inherit;text-decoration:none;" href="/players/<%=game.whiteName%>" class="game-win-<%=(game.result==="1-0")%>"><%=game.whiteName%></a></p>
                        </div>
                        <p class="game-card-result"><%=game.result%></p>
                        <p class="game-card-black-player"><a style="font-weight:inherit; color:inherit;text-decoration:none;" href="/players/<%=game.blackName%>" class="game-win-<%=(game.result==="0-1")%>"><%=game.blackName%></a> - <span class="black-highlight">Black</span></p>
                        <p class="tournament-game-card-black-player-mobile"><span class="black-highlight">Black</span> <a style="font-weight:inherit; color:inherit;text-decoration:none;" href="/players/<%=game.blackName%>" class="game-win-<%=(game.result==="0-1")%>"><%=game.blackName%></a></p>
                        <div class="game-card-extras">
                            <p class="game-card-type"><%= (game.locationID == 1) ? "Online" : "OTB" %></p>
                            <p class="game-card-date"><%=game.dateStr%></p>
                            <button class="iframe-button-<%=(game.link !== null)%> iframe-button"><%= (game.link) ? "🔽" : ""%></button>
                            <a class="view-game-<%= (game.link !== null)%>" target="_blank" href="https://lichess.org/<%=game.link%>"><img class="game-card-view-game" src="/images/icons/chessLinkIcon.png" alt="View Game"></a>
                            <button class="notes-<%=(game.notes !== null)%> notes-button"><%= (game.notes) ? "📝" : ""%></button>
                        </div>
                    </div>
                    <div class="iframe-section iframe-active-false">
                        <iframe class="lichess-embed" data-src = "https://lichess.org/embed/game/<%=game.link%>?theme=auto&bg=auto" src=""></iframe>
                    </div>
                    <div class="notes-section note-active-false">
                        <p><%= game.notes %></p>
                    </div>
                </div>
            <% }); %>
        </div>
    <script src="/js/main.js?v=3"></script>
    </body>


</html>